{
  "name": "doorman-fallacy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "vitest run",
    "test:site": "node scripts/test-site.ts",
    "check:copy": "node scripts/check-copy.ts",
    "check:docs": "node scripts/check-docs.ts",
    "check": "npm run lint && npm run lint:css && npm run typecheck && npm run test:unit && npm run check:copy && npm run check:docs",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "jiti": "2.7.0",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.2",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "esbuild": false,
    "workerd": false,
    "fsevents": false
  }
}

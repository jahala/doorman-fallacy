{
  "name": "doorman-fallacy",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "wrangler dev --local --local-upstream localhost:8787",
    "build": "astro build",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json && wrangler types --check",
    "test:unit": "vitest run",
    "test:worker": "vitest run -c vitest.worker.config.ts",
    "test:site": "node scripts/test-site.ts",
    "test:size": "node scripts/size-test.ts",
    "check:copy": "node scripts/check-copy.ts",
    "check:docs": "node scripts/check-docs.ts",
    "check:cases": "node scripts/check-cases.ts",
    "check": "npm run sync && npm run lint && npm run lint:css && npm run typecheck && npm run test:unit && npm run test:worker && npm run check:copy && npm run check:docs && npm run check:cases",
    "release": "bash scripts/release.sh",
    "sync": "astro sync",
    "prepare": "node scripts/install-hooks.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.7",
    "@astrojs/rss": "4.0.19",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/prata": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.7",
    "satori": "0.63.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "jiti": "2.7.0",
    "stylelint": "18.0.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wrangler": "4.158.0",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "esbuild": false,
    "workerd": false,
    "fsevents": false
  }
}

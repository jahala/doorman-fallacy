---
import type { LedgerRow } from '../data/ledger-row.ts';

interface Props {
  rows: readonly LedgerRow[];
  /** A line under the table. Left out when the page puts its own line there. */
  caption?: string;
  label: string;
  /** The home page's preview: no visible column heads, and the status under the change in place of the outcome. */
  compact?: boolean;
}

const { rows, caption, label, compact = false } = Astro.props;
---

<div class="ledger-wrap" role="region" aria-label={label} tabindex="0">
  <table class:list={['ledger', { 'ledger--compact': compact }]} role="table">
    {caption !== undefined && <caption class="t-small ink-3">{caption}</caption>}
    <thead class:list={{ 'visually-hidden': compact }}>
      <tr class="t-small ink-2" role="row">
        <th scope="col" role="columnheader">Company</th>
        <th scope="col" role="columnheader">{compact ? 'Change and reported outcome' : 'Change'}</th>
        {!compact && <th scope="col" role="columnheader">Reported outcome</th>}
        <th scope="col" role="columnheader">Case</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr role="row">
            <th scope="row" role="rowheader">
              <span class="ledger__company t-subhead">{row.company}</span>
              <span class="ledger__meta t-small ink-2">{row.meta}</span>
            </th>
            {
              compact ? (
                <td role="cell">
                  <span class="ledger__change">{row.change}</span>
                  <span class="ledger__status t-small ink-2">Reported outcome: {row.status}.</span>
                </td>
              ) : (
                <>
                  <td role="cell" data-label="Change">{row.change}</td>
                  <td role="cell" data-label="Reported outcome">
                    <span class="ledger__status t-small ink-2">{row.status}</span>
                    {row.outcome}
                  </td>
                </>
              )
            }
            <td role="cell" class="ledger__case">
              <a href={row.href}>
                Read case<span class="visually-hidden"> on {row.company}</span>
              </a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .ledger-wrap {
    /* Positioned so visually hidden text in a cell is clipped with the table, not the page. */
    position: relative;
    overflow-x: auto;
  }

  .ledger {
    inline-size: 100%;
    border-collapse: collapse;
  }

  .ledger caption {
    caption-side: bottom;
    padding-block-start: var(--space-4);
    text-align: start;
  }

  .ledger th,
  .ledger td {
    padding: var(--space-6) var(--space-4);
    border-block-end: var(--hairline) solid var(--rule);
    font-weight: inherit;
    text-align: start;
    vertical-align: baseline;
  }

  .ledger thead th {
    padding-block: var(--space-4);
    border-block-start: var(--hairline) solid var(--rule);
  }

  .ledger__company {
    display: block;
  }

  .ledger__status {
    display: block;
    margin-block-end: var(--space-1);
  }

  /* The preview: the change, then its status beneath it. */
  .ledger--compact .ledger__change {
    display: block;
  }

  .ledger--compact .ledger__status {
    margin-block: var(--space-2) 0;
  }

  @media (width >= 40rem) {
    .ledger--compact tbody tr:first-child > * {
      border-block-start: var(--hairline) solid var(--rule);
    }
  }

  .ledger__meta {
    display: block;
    margin-block-start: var(--space-1);
  }

  /* Narrow screens: each row becomes a block, each cell names its column */
  @media (width < 40rem) {
    .ledger thead {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .ledger tbody,
    .ledger tr,
    .ledger th,
    .ledger td {
      display: block;
    }

    /* A column, so the caption can follow the rows as it does on wide screens. */
    .ledger {
      display: flex;
      flex-direction: column;
    }

    .ledger tbody tr {
      padding-block: var(--space-6);
      border-block-end: var(--hairline) solid var(--rule);
    }

    .ledger tbody tr:first-child {
      margin-block-start: var(--space-4);
      border-block-start: var(--hairline) solid var(--rule);
    }

    .ledger tbody th,
    .ledger tbody td {
      padding: 0;
      border: 0;
    }

    .ledger tbody td {
      margin-block-start: var(--space-3);
    }

    .ledger td[data-label]::before {
      content: attr(data-label);
      display: block;
      color: var(--ink-2);
      font-size: var(--small-size);
    }

    .ledger caption {
      display: block;
      order: 1;
    }
  }
</style>

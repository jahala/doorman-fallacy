---
import { hiddenFunctions, type HiddenFunctionId } from '../data/hidden-functions.ts';

/** One numbered question. The default slot is the question; `after` holds anything between it and the writing space. */
interface Props {
  /** The hidden function this question asks about, shown as a small label after it. */
  tag?: HiddenFunctionId | undefined;
  /** Ruled writing lines under the question. A question that brings its own space passes 0. */
  lines?: number;
  /** Spans the full width when the questions are set in pairs on paper. */
  wide?: boolean;
}

const { tag, lines = 2, wide = false } = Astro.props;
---

<li class:list={['checklist__question', { 'checklist__question--wide': wide }]}>
  <p class="checklist__text">
    <slot />{' '}
    {tag !== undefined && <span class="checklist__tag ink-2">({hiddenFunctions[tag].label})</span>}
  </p>
  <slot name="after" />
  {
    lines > 0 && (
      <div class="checklist__lines" aria-hidden="true">
        {Array.from({ length: lines }, () => <span class="checklist__line" />)}
      </div>
    )
  }
</li>

<style>
  .checklist__text {
    font-weight: 500;
  }

  .checklist__tag {
    font-size: var(--small-size);
    font-weight: 400;
    white-space: nowrap;
  }

  .checklist__lines {
    display: grid;
  }

  .checklist__line {
    display: block;
    block-size: 2.75rem;
    border-block-end: var(--hairline) solid var(--rule);
  }

  @media print {
    .checklist__tag {
      font-size: 10pt;
    }

    .checklist__line {
      block-size: var(--print-line, 7mm);
      border-block-end: 0.5pt solid var(--field);
    }
  }
</style>

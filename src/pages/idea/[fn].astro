---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import HiddenIcon from '../../components/HiddenIcon.astro';
import Pager from '../../components/Pager.astro';
import TextSection from '../../components/TextSection.astro';
import { hiddenFunctionIds, hiddenFunctions, type HiddenFunctionId } from '../../data/hidden-functions.ts';
import Site from '../../layouts/Site.astro';
import { casesMissing, neighbours } from '../../lib/hidden-work.ts';
import type { PagerLink } from '../../lib/navigation.ts';
import { ideaCard, ogPath, shareImage } from '../../lib/share.ts';

export function getStaticPaths() {
  return hiddenFunctionIds.map((fn) => ({ params: { fn } }));
}

const id = Astro.params.fn as HiddenFunctionId;
const { label, meaning, atTheHotel, today, whenMissing, ask } = hiddenFunctions[id];
const found = casesMissing(await getCollection('cases'), id);
const { previous, next } = neighbours(id);
const fnLink = (fn: HiddenFunctionId): PagerLink => ({ label: hiddenFunctions[fn].label, href: `/idea/${fn}` });
// The first kind leads back to the list of six, and the last on to the next chapter of /idea.
const previousLink = previous === null ? { label: 'The hidden work', href: '/idea#hidden' } : fnLink(previous);
const nextLink = next === null ? { label: 'The three questions', href: '/idea#questions' } : fnLink(next);
---

<Site
  title={`${label}: the hidden work`}
  current="idea"
  type="article"
  description={`${meaning}. An example from the hotel door, one from today, and the cases in the ledger.`}
  image={shareImage(ideaCard(id), ogPath.idea(id))}
>
  <div class="page">
    <header class="fn-head section">
      <div class="fn-head__crumbs">
        <Breadcrumbs
          trail={[
            { label: 'The idea', href: '/idea' },
            { label: 'The hidden work', href: '/idea#hidden' },
          ]}
          here={label}
        />
      </div>
      <HiddenIcon id={id} size="large" class="ink-2" />
      <h1 class="t-display">{label}</h1>
      <p class="t-lead ink-2">{meaning}</p>
    </header>

    <TextSection id="hotel-title" title="At the hotel">
      <p>{atTheHotel}</p>
    </TextSection>

    <TextSection id="today-title" title="Today">
      <p>{today}</p>
      <p class="t-caption ink-3">An illustration, not a reported case.</p>
    </TextSection>

    <TextSection id="missing-title" title="When it goes missing">
      <p>{whenMissing}</p>
    </TextSection>

    <TextSection id="ask-title" title="The question to ask">
      <p class="fn-ask t-subhead">{ask}</p>
    </TextSection>

    <TextSection id="ledger-title" title="In the ledger">
      {
        found.length === 0 ? (
          <p class="ink-2">No case in the ledger records this kind of work going missing yet.</p>
        ) : (
          <>
            <ul class="fn-cases">
              {found.map((item) => (
                <li>
                  <p class="fn-cases__name t-subhead">
                    <a href={item.href}>{item.short}</a>
                  </p>
                  <p class="ink-2">{item.change}</p>
                  {item.evidence.map((sentence) => <p>{sentence}</p>)}
                </li>
              ))}
            </ul>
            <p class="t-small ink-3">
              Each is from the case&rsquo;s doorman reading, which is the site&rsquo;s own analysis and names the evidence it rests on.
            </p>
          </>
        )
      }
    </TextSection>

    <Pager
      previous={previousLink}
      previousKind={previous === null ? 'Back to' : 'Previous'}
      next={nextLink}
    />
  </div>
</Site>

<style>
  .fn-head {
    display: grid;
    row-gap: var(--space-8);
  }

  .fn-head__crumbs {
    margin-block-end: calc(var(--space-4) * -1);
  }

  .fn-head > .t-lead {
    max-inline-size: 28em;
  }

  .fn-ask {
    max-inline-size: 20em;
  }

  .fn-cases {
    display: grid;
    gap: var(--space-8);
  }

  .fn-cases li > * + * {
    margin-block-start: var(--space-2);
  }
</style>

---
import { getCollection } from 'astro:content';
import LedgerEmpty from '../components/LedgerEmpty.astro';
import LedgerTable from '../components/LedgerTable.astro';
import Photo from '../components/Photo.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { hiddenFunctionIds, hiddenFunctions } from '../data/hidden-functions.ts';
import Site from '../layouts/Site.astro';
import { countLabel, ledgerRow, outcomesFirst } from '../lib/ledger.ts';

const previewLength = 5;
const cases = outcomesFirst(await getCollection('cases'));
const previewRows = cases.slice(0, previewLength).map(ledgerRow);
---

<Site title="The Doorman Fallacy">
  <div class="page">
    <section class="section grid hero" aria-labelledby="hero-title">
      <div class="hero__text">
        <h1 id="hero-title" class="t-hero">What does a doorman actually do?</h1>
        <p class="t-lead">
          Opening the door is only part of the job. There&rsquo;s also recognising guests, finding a taxi
          and noticing when something is wrong.
        </p>
        <p class="t-lead ink-2">
          Rory Sutherland called replacing the person with an automatic door the doorman fallacy.
        </p>
        <p class="hero__link"><a href="/idea">Read the idea</a></p>
        <p class="hero__credit t-caption ink-3">Rory Sutherland, <i>Alchemy</i>, 2019.</p>
      </div>
      <div class="hero__photo">
        <Photo id="hero" sizes="(min-width: 56rem) 50vw, 100vw" priority />
      </div>
    </section>

    <section class="section grid beyond" aria-labelledby="beyond-title">
      <div class="beyond__head">
        <h2 id="beyond-title" class="t-display">The work beyond the task.</h2>
        <p class="t-lead ink-2">
          The fallacy is judging a role by its most visible task and overlooking the other work it carries.
        </p>
      </div>
      <div class="beyond__body">
        <ul class="beyond__list">
          {
            hiddenFunctionIds.map((id) => (
              <li>
                <a class="beyond__name t-subhead" href={`/idea#${id}`}>
                  {hiddenFunctions[id].label}
                </a>
                <p class="ink-2">{hiddenFunctions[id].meaning}</p>
              </li>
            ))
          }
        </ul>
        <p class="beyond__link"><a href="/idea#questions">Before automating a role</a></p>
      </div>
    </section>

    <section class="section" aria-labelledby="ledger-title">
      <h2 id="ledger-title" class="t-display">The ledger</h2>
      <p class="t-lead ink-2 section__sub">Following what happens after organisations cut roles for AI.</p>
      <p class="ledger-preview__all"><a href="/ledger">View all cases</a></p>
      {
        previewRows.length === 0 ? (
          <div class="ledger-preview">
            <LedgerEmpty heading="h3" size="title" />
          </div>
        ) : (
          <div class="ledger-preview">
            <LedgerTable
              rows={previewRows}
              compact
              caption={`${countLabel(cases.length)} in the ledger, those with a reported outcome first. Each has its sources, an update history and a date for its next review, and cuts that hold up are followed as closely as those that are reversed.`}
              label="Ledger preview"
            />
          </div>
        )
      }
    </section>

    <section id="subscribe" class="section grid signup" aria-labelledby="subscribe-title">
      <div class="signup__head">
        <h2 id="subscribe-title" class="t-title">Updates from the ledger</h2>
        <p class="signup__sub">A short email once a month, when the ledger has changed.</p>
      </div>
      <div class="signup__form">
        <SubscribeForm />
      </div>
    </section>
  </div>
</Site>

<style>
  /* The work beyond the task: the heading under the hero's text, the six kinds in two columns under its photo. */
  .beyond {
    row-gap: var(--space-12);
  }

  .beyond__head,
  .beyond__body {
    grid-column: 1 / -1;
  }

  .beyond__head .t-lead {
    max-inline-size: 22em;
    margin-block-start: var(--space-8);
  }

  .beyond__list {
    display: grid;
    gap: var(--space-8) var(--grid-gap);
  }

  .beyond__name {
    text-decoration-color: var(--rule);
  }

  .beyond__name:hover {
    text-decoration-color: currentcolor;
  }

  .beyond__list p {
    max-inline-size: 24em;
    margin-block-start: var(--space-1);
  }

  .beyond__link {
    margin-block-start: var(--space-12);
  }

  @media (width >= 40rem) {
    .beyond__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 56rem) {
    .beyond__head {
      grid-column: 1 / span 6;
    }

    .beyond__body {
      grid-column: 7 / span 6;
    }
  }

  .ledger-preview__all {
    margin-block-start: var(--space-4);
  }

  .ledger-preview {
    margin-block-start: var(--space-8);
  }

  /* The sign-up: a form, so its heading is a step smaller than the sections above. */
  .signup {
    row-gap: var(--space-8);
    align-items: start;
  }

  .signup__head,
  .signup__form {
    grid-column: 1 / -1;
  }

  .signup__sub {
    margin-block-start: var(--space-3);
  }

  @media (width >= 56rem) {
    .signup__head {
      grid-column: 1 / span 6;
    }

    .signup__form {
      grid-column: 7 / span 6;
    }
  }
</style>

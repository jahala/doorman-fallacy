---
import { getCollection } from 'astro:content';
import LedgerEmpty from '../components/LedgerEmpty.astro';
import LedgerSummary from '../components/LedgerSummary.astro';
import LedgerTable from '../components/LedgerTable.astro';
import Photo from '../components/Photo.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { definition } from '../data/definition.ts';
import Site from '../layouts/Site.astro';
import { countLabel, ledgerRow, newestFirst } from '../lib/ledger.ts';

const previewLength = 5;
const cases = newestFirst(await getCollection('cases'));
const previewRows = cases.slice(0, previewLength).map(ledgerRow);

const remains = [
  { title: 'The task being automated', question: 'What can the system now handle?' },
  { title: 'The work that remains', question: 'What did the person notice, remember or resolve?' },
  { title: 'Who takes it on', question: 'Another team, the customer, or nobody?' },
];

const starts = [
  {
    who: 'If you manage a team',
    text: 'Before automating a role, answer seven questions with the people who do it.',
    href: '/checks/before-you-cut',
    link: 'Before you cut',
  },
  {
    who: 'If your role is changing',
    text: 'Write down the work your job description leaves out, before the conversation.',
    href: '/checks/your-hidden-job',
    link: 'Your hidden job',
  },
  {
    who: 'If you report or research',
    text: 'Every case is sourced, archived and free to reuse, with the data to download.',
    href: '/ledger',
    link: 'The ledger and its data',
  },
];

const checks = [
  {
    id: 'reviewed',
    title: 'If your role is being reviewed',
    lead: 'Write down the work that a job description leaves out.',
    questions: [
      'What do people come to you for?',
      'What do you prevent or resolve without being asked?',
      'What would colleagues or customers have to take on?',
    ],
    href: '/checks/your-hidden-job',
    link: 'Open Your hidden job',
  },
  {
    id: 'automating',
    title: 'If you are automating a role',
    lead: 'Account for the responsibilities that will remain.',
    questions: [
      'Which tasks can the system handle reliably?',
      'Who takes responsibility for the exceptions?',
      'What will you measure after the change?',
    ],
    href: '/checks/before-you-cut',
    link: 'Open Before you cut',
  },
];
---

<Site title="The Doorman Fallacy">
  <div class="page">
    <section class="section grid hero" aria-labelledby="hero-title">
      <div class="hero__text">
        <h1 id="hero-title" class="t-display">What does a doorman actually do?</h1>
        <p class="t-lead">
          Opening the door is only part of the job. There&rsquo;s also recognising guests, finding a taxi
          and noticing when something is wrong.
        </p>
        <p class="t-lead ink-2">
          Rory Sutherland called replacing the person with an automatic door the doorman fallacy.
        </p>
        <p class="hero__link"><a href="/idea">Read the explanation</a></p>
        <p class="hero__credit t-caption ink-3">Rory Sutherland, <i>Alchemy</i>, 2019.</p>
      </div>
      <div class="hero__photo">
        <Photo id="hero" sizes="(min-width: 56rem) 50vw, 100vw" priority />
      </div>
    </section>

    <section class="band grid" aria-labelledby="definition-label">
      <h2 id="definition-label" class="band__label t-caption ink-2">The doorman fallacy</h2>
      <p class="band__statement t-title">{definition}</p>
      <p class="band__cite t-small"><a href="/idea#cite">How to cite</a></p>
    </section>

    <section class="section" aria-labelledby="start-title">
      <h2 id="start-title" class="t-title">Start here</h2>
      <ul class="grid columns columns--3">
        {
          starts.map((start) => (
            <li class="ruled">
              <h3 class="start__who t-lead">{start.who}</h3>
              <p class="ink-2">{start.text}</p>
              <p class="start__link"><a href={start.href}>{start.link}</a></p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="remains-title">
      <div class="grid split">
        <h2 id="remains-title" class="t-display split__head">What else was the person doing?</h2>
        <p class="split__side">
          When a company automates customer support, answering questions is the obvious task. Recognising a
          recurring problem, calming an angry customer and knowing when to make an exception are harder to
          measure.
        </p>
      </div>
      <ul class="grid columns columns--3">
        {
          remains.map((item) => (
            <li class="ruled">
              <h3 class="t-title">{item.title}</h3>
              <p class="t-lead ink-2">{item.question}</p>
            </li>
          ))
        }
      </ul>
      <ul class="section__link section__links">
        <li><a href="/ledger">See what happened in practice</a></li>
        <li><a href="/idea#signs">Six signs of the mistake</a></li>
      </ul>
    </section>

    <section class="section" aria-labelledby="ledger-title">
      <div class="section-head">
        <div>
          <h2 id="ledger-title" class="t-display">The ledger</h2>
          <p class="t-lead ink-2 section__sub">What happened after companies cut roles for AI.</p>
        </div>
        <p><a href="/ledger">View all cases</a></p>
      </div>
      {
        previewRows.length === 0 ? (
          <LedgerEmpty heading="h3" />
        ) : (
          <>
            <LedgerSummary cases={cases} />
            <LedgerTable
              rows={previewRows}
              caption={`${countLabel(cases.length)} in the ledger, newest first.`}
              label="Ledger preview"
            />
          </>
        )
      }
      <div class="grid columns columns--2">
        <div>
          <h3 class="t-title">Follow-up is part of each case.</h3>
          <p class="t-lead ink-2">Entries include linked sources, an update history and a date for the next review.</p>
        </div>
        <div>
          <h3 class="t-title">Cuts that hold up belong here too.</h3>
          <p class="t-lead ink-2">The ledger follows reversals, strained transitions and outcomes that are still unclear.</p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="checks-title">
      <h2 id="checks-title" class="t-display">Before the decision.</h2>
      <p class="t-lead ink-2 section__sub">Two printable guides for making the work visible.</p>
      <div class="grid columns columns--2">
        {
          checks.map((check) => (
            <div class="ruled check">
              <h3 id={`check-${check.id}`} class="t-title">{check.title}</h3>
              <p class="t-lead ink-2">{check.lead}</p>
              <ul class="check__questions">
                {check.questions.map((question) => <li>{question}</li>)}
              </ul>
              <p class="check__link"><a href={check.href}>{check.link}</a></p>
            </div>
          ))
        }
      </div>
      <p class="t-small ink-3 section__note">Both guides are designed to print.</p>
    </section>

    <section id="subscribe" class="section grid split" aria-labelledby="subscribe-title">
      <div class="split__head">
        <h2 id="subscribe-title" class="t-display">Get updates from the ledger.</h2>
        <p class="t-lead section__sub">A short email once a month, when the ledger has changed.</p>
        <p class="ink-2">Unsubscribe at any time.</p>
      </div>
      <div class="split__side">
        <SubscribeForm />
      </div>
    </section>
  </div>
</Site>

<style>
  .band {
    row-gap: var(--space-4);
    padding-block: var(--space-12);
    border-block-end: var(--hairline) solid var(--rule);
  }

  .band > * {
    grid-column: 1 / -1;
  }

  .band__statement {
    max-inline-size: 32em;
  }

  .band__cite {
    margin-block-start: var(--space-2);
  }

  .start__who {
    font-weight: 500;
  }

  .start__who + p {
    margin-block-start: var(--space-3);
  }

  .start__link {
    margin-block-start: var(--space-6);
  }

  @media (width >= 56rem) {
    .band > .band__label {
      grid-column: 1 / span 4;
      grid-row: 1;
      padding-block-start: var(--space-2);
    }

    .band > .band__statement,
    .band > .band__cite {
      grid-column: 5 / span 8;
    }
  }
</style>

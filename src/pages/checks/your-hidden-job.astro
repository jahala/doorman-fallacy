---
import ChecklistPage from '../../components/ChecklistPage.astro';
import ChecklistQuestion from '../../components/ChecklistQuestion.astro';
import type { HiddenFunctionId } from '../../data/hidden-functions.ts';

const questions: readonly { text: string; tag?: HiddenFunctionId }[] = [
  { text: 'What do people come to you for that is not in your job description?' },
  { text: 'Who feels looked after because a person is there, rather than a system?', tag: 'signal' },
  { text: 'What goes wrong less often because you are there?', tag: 'deterrence' },
  { text: 'When do you make an exception or pass a problem upwards, and how do you decide?', tag: 'judgment' },
  {
    text: 'What do you know that is written down nowhere: people, history, the way things really work?',
    tag: 'memory',
  },
  { text: 'Who do you calm down, reassure or talk round?', tag: 'absorption' },
  { text: 'What do you handle in a busy week, an outage or a crisis?', tag: 'slack' },
  { text: 'If your role went, who would take this work on? Would they know it was there?' },
  { text: 'One example, with a date, that shows the work above.' },
];
---

<ChecklistPage
  title="Your hidden job"
  lead="Write down the work your job description leaves out."
  intro="Use this before a review, a restructuring conversation or an interview. Answer in your own words, with real examples: a date, a customer, a problem you caught."
  description="A printable guide for people whose role is under review: write down the work your job description leaves out."
  companion={{ label: 'Before you cut', href: '/checks/before-you-cut' }}
>
  {questions.map(({ text, tag }) => <ChecklistQuestion tag={tag}>{text}</ChecklistQuestion>)}
</ChecklistPage>

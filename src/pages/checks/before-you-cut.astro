---
import ChecklistPage from '../../components/ChecklistPage.astro';
import ChecklistQuestion from '../../components/ChecklistQuestion.astro';
import { hiddenFunctions } from '../../data/hidden-functions.ts';

const functions = Object.values(hiddenFunctions);
---

<ChecklistPage
  title="Before you cut"
  lead="Account for the work that will remain."
  intro="Answer these before deciding to automate a role, with the people who do the job in the room."
  description="A printable guide for managers about to automate a role: account for the work that will remain."
  companion={{ label: 'Your hidden job', href: '/checks/your-hidden-job' }}
  layout="paired"
>
  <ChecklistQuestion lines={3}>
    Which tasks can the system handle reliably today, measured on your own cases rather than a demonstration?
  </ChecklistQuestion>
  <ChecklistQuestion lines={3}>
    What do the people in this role do that their job description does not list? Ask them; the companion
    guide helps.
  </ChecklistQuestion>
  <ChecklistQuestion lines={0} wide>
    The hidden work
    <table slot="after" class="checklist__table">
      <thead>
        <tr class="t-small ink-2">
          <th scope="col"><span class="visually-hidden">Kind of work</span></th>
          <th scope="col">Does the role carry it?</th>
          <th scope="col">Who carries it after the change?</th>
        </tr>
      </thead>
      <tbody>
        {
          functions.map(({ label, meaning }) => (
            <tr>
              <th scope="row">
                <span class="checklist__function">{label}</span>
                <span class="checklist__meaning ink-2">{meaning}</span>
              </th>
              <td class="checklist__cell" data-label="Does the role carry it?" />
              <td class="checklist__cell" data-label="Who carries it after the change?" />
            </tr>
          ))
        }
      </tbody>
    </table>
  </ChecklistQuestion>
  <ChecklistQuestion lines={3}>
    Who takes responsibility for the cases the system cannot handle, and how do people reach them?
  </ChecklistQuestion>
  <ChecklistQuestion lines={3}>What will customers or colleagues lose that they will not complain about?</ChecklistQuestion>
  <ChecklistQuestion lines={3}>
    What will you measure after the change, beyond cost and volume? For example repeat contacts, complaints,
    errors, time to resolve the hard cases, and the workload of the people who remain.
  </ChecklistQuestion>
  <ChecklistQuestion lines={3}>What result, by when, would make you reverse the decision?</ChecklistQuestion>
</ChecklistPage>

<style>
  .checklist__table {
    inline-size: 100%;
    margin-block-start: var(--space-4);
    border-collapse: collapse;
  }

  .checklist__table th,
  .checklist__table td {
    border: var(--hairline) solid var(--rule);
    text-align: start;
    vertical-align: top;
  }

  .checklist__table thead th {
    padding: var(--space-2) var(--space-3);
    font-weight: 500;
  }

  .checklist__table tbody th {
    inline-size: 40%;
    padding: var(--space-3);
    font-weight: 400;
  }

  .checklist__table td {
    inline-size: 30%;
    block-size: 4.5rem;
  }

  .checklist__function {
    display: block;
    font-weight: 500;
  }

  .checklist__meaning {
    display: block;
    font-size: var(--small-size);
  }

  @media screen and (width < 40rem) {
    .checklist__table thead {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .checklist__table,
    .checklist__table tbody,
    .checklist__table tr,
    .checklist__table th,
    .checklist__table td {
      display: block;
    }

    .checklist__table tbody tr {
      margin-block-end: var(--space-6);
    }

    .checklist__table tbody th,
    .checklist__table td {
      inline-size: auto;
    }

    .checklist__table td {
      block-size: 3.5rem;
    }

    .checklist__table td::before {
      content: attr(data-label);
      display: block;
      padding: var(--space-2) var(--space-3) 0;
      color: var(--ink-2);
      font-size: var(--small-size);
    }
  }

  @media print {
    .checklist__table {
      margin-block: 1.5mm 2mm;
    }

    .checklist__table th,
    .checklist__table td {
      border-color: var(--field);
      border-width: 0.5pt;
    }

    .checklist__table thead th {
      padding: 1mm 2mm;
      font-size: 10pt;
    }

    .checklist__table tbody th {
      inline-size: 50%;
      padding: 1mm 2mm;
    }

    .checklist__table td {
      inline-size: 25%;
      block-size: 9mm;
    }

    .checklist__meaning {
      font-size: 10pt;
    }
  }
</style>

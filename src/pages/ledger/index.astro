---
import { getCollection } from 'astro:content';
import ExternalLink from '../../components/ExternalLink.astro';
import LedgerEmpty from '../../components/LedgerEmpty.astro';
import LedgerSummary from '../../components/LedgerSummary.astro';
import LedgerTable from '../../components/LedgerTable.astro';
import NumberedList from '../../components/NumberedList.astro';
import PageHead from '../../components/PageHead.astro';
import Pager from '../../components/Pager.astro';
import SavedLost from '../../components/SavedLost.astro';
import TextSection from '../../components/TextSection.astro';
import { afterSigns } from '../../data/signs.ts';
import { statuses } from '../../data/statuses.ts';
import Site from '../../layouts/Site.astro';
import { countLabel, ledgerRow, newestFirst } from '../../lib/ledger.ts';

const cases = newestFirst(await getCollection('cases'));
const rows = cases.map(ledgerRow);
const statusRows = Object.values(statuses);

const contents = [
  { id: 'cases', label: 'The cases' },
  { id: 'watch', label: 'What the ledger watches for' },
  { id: 'statuses', label: 'Statuses and follow-up' },
  { id: 'known', label: 'What is known beyond the ledger' },
  { id: 'data', label: 'The data' },
] as const;

const known = [
  {
    text: 'Forrester’s Predictions 2026: The Future of Work, published in October 2025, forecast that about half of AI-attributed layoffs would be reversed through quiet rehiring, at lower pay or offshore.',
    source: 'Resultsense, 30 October 2025',
    href: 'https://www.resultsense.com/news/2025-10-30-forrester-predicts-ai-layoff-reversals-lower-pay/',
  },
  {
    text: 'A 2025 survey by Orgvue, which sells organisational design and planning software, asked more than 1,000 business leaders. About 4 in 10 said they had laid off employees as a result of deploying AI. Of those, 55 percent said they had made the wrong decisions about it.',
    source: 'HR Dive, 29 April 2025',
    href: 'https://www.hrdive.com/news/leaders-who-laid-off-workers-due-to-ai-regretted-it/746643/',
  },
  {
    text: 'A 2026 survey for SHL, which provides talent assessment to recruiters and employers, asked 2,036 employed adults in the United States and the United Kingdom in June and July 2026. Nearly one in five in the US (19 percent) and about one in eight in the UK (13 percent) said they had first-hand experience of being replaced by AI and later asked back. The release gives what workers would want in order to return, but does not say whether those shares are of everyone asked or only of those asked back.',
    source: 'SHL, 29 October 2026',
    href: 'https://www.shl.com/about/news-and-events/press-releases/workers-replaced-by-ai-would-demand-higher-pay-and-greater-job-security-to-return-shl-research-finds/',
  },
] as const;
---

<Site
  title="The ledger"
  description="What happened after organisations cut roles for AI: every case, newest first, with sources and a date to look again."
  current="ledger"
>
  <div class="page">
    <PageHead title="The ledger" lead="What happened after organisations cut roles for AI." contents={contents} />

    <TextSection id="cases-title" anchor="cases" number={1} title="The cases">
      {
        rows.length === 0 ? (
          <LedgerEmpty heading="h3" size="subhead" />
        ) : (
          <LedgerSummary cases={cases} />
        )
      }
      {
        rows.length > 0 && (
          <div slot="wide">
            <LedgerTable rows={rows} label="Cases, newest announcement first" />
            <p class="ledger-count t-small ink-2">
              {countLabel(rows.length)} in the ledger. <a href="/approach">How the ledger is kept</a>
            </p>
          </div>
        )
      }
    </TextSection>

    <TextSection id="watch-title" anchor="watch" number={2} title="What the ledger watches for">
      <p>
        When an organisation announces cuts linked to AI, these are the signs, months later, that the hidden work
        went missing. The ledger looks for them each time it checks a case again. A case that holds up shows the
        opposite.
      </p>
      <NumberedList items={afterSigns} />
      <SavedLost slot="wide" />
    </TextSection>

    <TextSection id="statuses-title" anchor="statuses" number={3} title="Statuses and follow-up">
      <p>
        A case is a record that keeps changing. Each one is checked again on a schedule set by its status, and its
        page says when it was last checked, even when nothing new was found.
      </p>
      <table class="statuses">
        <thead>
          <tr class="t-small ink-2">
            <th scope="col">Status</th>
            <th scope="col">Meaning</th>
          </tr>
        </thead>
        <tbody>
          {
            statusRows.map(({ label, meaning }) => (
              <tr>
                <th scope="row" class="t-label">{label}</th>
                <td class="ink-2">{meaning}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p>
        Too early to tell and strained cases are checked after three months. Holding cases after six months, then
        every year. Partly reversed cases after six months. Reversed cases once more after a year.
      </p>
    </TextSection>

    <TextSection id="known-title" anchor="known" number={4} title="What is known beyond the ledger">
      <p>
        The ledger records named cases with sources. Around it, two surveys and a forecast are widely quoted. Here is
        what they say, and where they come from.
      </p>
      {
        known.map(({ text, source, href }) => (
          <div class="known__item">
            <p>{text}</p>
            <p class="t-small ink-2">
              Source: <ExternalLink href={href}>{source}</ExternalLink>
            </p>
          </div>
        ))
      }
      <p class="ink-2">
        Surveys and forecasts are not cases. A survey reports what people say, a forecast is a judgement about the
        future, and some come from companies that sell tools for the decision they describe. The ledger counts only
        what named organisations did, from sources anyone can check.
      </p>
    </TextSection>

    <TextSection id="data-title" anchor="data" number={5} title="The data">
      <p>
        Download the whole ledger as <a href="/ledger.csv">CSV</a> or <a href="/ledger.json">JSON</a>, or follow new
        cases and updates with the <a href="/rss.xml">RSS feed</a>.
      </p>
      <p>
        The cases are free to reuse under{' '}
        <ExternalLink href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</ExternalLink>, with credit to The
        Doorman Fallacy. To cite the idea itself, use the <a href="/idea#cite">citation on the idea page</a>.
      </p>
      <p>
        For press and research questions, write to <a href="mailto:hello@thedoormanfallacy.com">hello@thedoormanfallacy.com</a>.
      </p>
    </TextSection>

    <Pager
      previous={{ label: 'The idea', href: '/idea' }}
      next={{ label: 'How the ledger is kept', href: '/approach' }}
    />
  </div>
</Site>

<style>
  .ledger-count {
    margin-block-start: var(--space-4);
  }

  .known__item > p + p {
    margin-block-start: var(--space-2);
  }

  .statuses {
    inline-size: 100%;
    border-collapse: collapse;
  }

  .statuses th,
  .statuses td {
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-block-end: var(--hairline) solid var(--rule);
    text-align: start;
    vertical-align: baseline;
  }

  .statuses thead th {
    border-block-start: var(--hairline) solid var(--rule);
    font-weight: inherit;
  }

  .statuses tbody th {
    inline-size: 11rem;
  }

  @media (width < 40rem) {
    .statuses tbody th {
      inline-size: 7rem;
    }
  }
</style>

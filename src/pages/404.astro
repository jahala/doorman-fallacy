---
import Site from '../layouts/Site.astro';
---

<Site title="Page not found">
  <div class="page">
    <section class="section stack">
      <h1 class="t-display">This page is not here.</h1>
      <p class="t-lead ink-2 prose">The address may have a typo, or the page may have moved.</p>
      <ul class="stack t-lead">
        <li><a href="/">Back to the home page</a></li>
        <li><a href="/idea">Read the idea</a></li>
        <li><a href="/ledger">Browse the ledger</a></li>
      </ul>
    </section>
  </div>
</Site>

---
import '@fontsource-variable/inter/opsz.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import '@fontsource/prata/400.css';
import headingLatin from '@fontsource/prata/files/prata-latin-400-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/print.css';
import tokensCss from '../styles/tokens.css?raw';
import { ogPath, shareImage, siteCard, type ShareImage } from '../lib/share.ts';
import { schemePalette } from '../lib/tokens.ts';
import ExternalLink from '../components/ExternalLink.astro';
import { repository } from '../data/repository.ts';

const siteName = 'The Doorman Fallacy';
/** The site map in the footer: every page and chapter, grouped as the header groups them. */
const siteMap = [
  {
    label: 'The idea',
    links: [
      { label: 'The story', href: '/idea#story' },
      { label: 'The hidden work', href: '/idea#hidden' },
      { label: 'The three questions', href: '/idea#questions' },
      { label: 'When automation is right', href: '/idea#right-call' },
      { label: 'Further reading', href: '/idea#reading' },
    ],
  },
  {
    label: 'The ledger',
    links: [
      { label: 'The cases', href: '/ledger' },
      { label: 'What it watches for', href: '/ledger#watch' },
      { label: 'The data', href: '/ledger#data' },
      { label: 'How the ledger is kept', href: '/approach' },
      { label: 'Suggest a case', href: '/suggest' },
    ],
  },
  {
    label: 'The site',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Subscribe', href: '/#subscribe' },
      { label: 'RSS feed', href: '/rss.xml' },
      { label: 'Privacy', href: '/privacy' },
      { label: 'Source code', href: repository.url, external: true },
    ],
  },
] as const;
const nav = [
  { key: 'idea', label: 'The idea', href: '/idea' },
  { key: 'ledger', label: 'The ledger', href: '/ledger' },
  { key: 'about', label: 'About', href: '/about' },
  { key: 'subscribe', label: 'Subscribe', href: '/#subscribe' },
] as const;

interface Props {
  title: string;
  description?: string;
  current?: (typeof nav)[number]['key'];
  noindex?: boolean;
  /** The share card for this page. Pages that have none show the site's. */
  image?: ShareImage;
  /** Open Graph type: articles are the case pages and the pages for one kind of hidden work. */
  type?: 'website' | 'article';
}

const {
  title,
  description = 'The idea behind the doorman fallacy, and a sourced ledger of what happened after companies cut roles for AI.',
  current,
  noindex = false,
  image = shareImage(siteCard(), ogPath.site),
  type = 'website',
} = Astro.props;

const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const address = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image.path, Astro.site).href;
const light = schemePalette(tokensCss, 'light');
const dark = schemePalette(tokensCss, 'dark');
if (light === undefined || dark === undefined) throw new Error('src/styles/tokens.css is missing a colour token');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={address.href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={light.paper} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={dark.paper} media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={address.href} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName}: new cases and updates`} href="/rss.xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="page">
        <a class="wordmark" href="/">{siteName}</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page">
        <div class="grid site-footer__top">
          <div class="site-footer__id">
            <p class="wordmark">{siteName}</p>
          </div>
          <nav class="site-footer__map" aria-label="Site map">
            {
              siteMap.map((group) => (
                <div>
                  <p class="t-small ink-2">{group.label}</p>
                  <ul class="t-small">
                    {group.links.map((link) => (
                      <li>
                        {'external' in link ? <ExternalLink href={link.href}>{link.label}</ExternalLink> : <a href={link.href}>{link.label}</a>}
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </nav>
        </div>
        <p class="print-only t-caption">{address.href}</p>
        <p class="site-footer__credit t-caption">
          The doorman fallacy is an idea from Rory Sutherland's <i>Alchemy</i> (2019).
        </p>
      </div>
    </footer>
  </body>
</html>
